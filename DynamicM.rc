/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU PRELOAD DISCARDABLE 
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM "打开(&O)...\tCtrl+O",         ID_FILE_OPEN
        MENUITEM "保存(&S)\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "另存为(&A)...",               ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "打印(&P)...\tCtrl+P",         ID_FILE_PRINT
        MENUITEM "打印预览(&V)",                ID_FILE_PRINT_PREVIEW
        MENUITEM "打印设置(&R)...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "最近文件",                    ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                    ID_APP_EXIT
    END
    POPUP "Plan Model"
    BEGIN
        MENUITEM "Initial Structure",           ID_INI_STR
        MENUITEM "Initial Front",               ID_INI_FRONT
        MENUITEM SEPARATOR
        MENUITEM "Multi Migration",             ID_MOVE_HEI
        MENUITEM "平面模拟",                    ID_PLAN
        MENUITEM SEPARATOR
        MENUITEM "Indenpedent Migration",       ID_INDENPEDENT_MIG
    END
    POPUP "Section Model"
    BEGIN
        MENUITEM "ip gravity",                  ID_IP_GRAVITY
        MENUITEM "test",                        ID_TEST
        MENUITEM SEPARATOR
        MENUITEM "剖面模拟",                    ID_SECTION_SIMULATE
        MENUITEM SEPARATOR
    END
    POPUP "Tool"
    BEGIN
        MENUITEM "set point",                   ID_SET_POINT
        MENUITEM "normal",                      ID_NORMAL
        MENUITEM "Front check",                 ID_FRONT
        MENUITEM "data charactor",              ID_COUNT
    END
    POPUP "3DView"
    BEGIN
        MENUITEM "3d show",                     ID_THREE_VIEW
    END
    POPUP "编辑(&E)"
    BEGIN
        MENUITEM "撤消(&U)\tCtrl+Z",            ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "剪切(&T)\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "复制(&C)\tCtrl+C",            ID_EDIT_COPY
        MENUITEM "粘贴(&P)\tCtrl+V",            ID_EDIT_PASTE
    END
    POPUP "查看(&V)"
    BEGIN
        MENUITEM "工具栏(&T)",                  ID_VIEW_TOOLBAR
        MENUITEM "状态栏(&S)",                  ID_VIEW_STATUS_BAR
    END
    POPUP "帮助(&H)"
    BEGIN
        MENUITEM "关于 DynamicM(&A)...",        ID_APP_ABOUT
    END
    POPUP "Pore Distribution"
    BEGIN
        MENUITEM "zheng tai",                   ID_MY_ZHENG
        MENUITEM "real zheng",                  ID_ZHENG
    END
    POPUP "Dynamic model"
    BEGIN
        MENUITEM "fluid with velocity",         ID_FLOW_VELOCITY
        MENUITEM "fluid through all pore",      ID_FLOW_ALLPORE
    END
    POPUP "public"
    BEGIN
        MENUITEM "publica",                     ID_PUBLICA
    END
    POPUP "compute"
    BEGIN
        MENUITEM "Contour",                     ID_NEW_CONTOUR
        MENUITEM SEPARATOR
        MENUITEM "test",                        ID_TEST1
        MENUITEM SEPARATOR
        MENUITEM "地形数据组合",                ID_DATA_COMPOSE
        MENUITEM SEPARATOR
        MENUITEM "含岩性流体势计算",            ID_NEW_PENTIAL
    END
    POPUP "Draw"
    BEGIN
        MENUITEM "drop section",                ID_pou
    END
END


